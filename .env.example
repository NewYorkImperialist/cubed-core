# Local research workspace. Video, labels, derived artifacts, and model files
# live here and are intentionally ignored by Git.
CUBED_CORE_WORKSPACE=./workspace

# Native `make workbench` binds this port on loopback. Compose publishes the
# container's fixed port 8000 on this host port, also loopback-only by default,
# and prints the host-side URL. The API has a local admin bearer token but no
# accounts or production-grade authentication. Use an SSH tunnel for a remote
# host; do not change the bind address to 0.0.0.0 on a public machine.
CUBED_CORE_BIND_ADDRESS=127.0.0.1
CUBED_CORE_PORT=8000

# Normally auto-detected in an editable checkout. Containers set this to /app.
# CUBED_CORE_REPO_ROOT=/absolute/path/to/cubed-core

# The loopback workbench authorizes its browser automatically. Set an explicit
# random value of at least 32 printable, non-whitespace characters only when
# multiple processes (Compose + smoke check) must share one token. Never commit
# a real value.
CUBED_CORE_ADMIN_TOKEN=

# Match the host user for writable, non-root Linux bind mounts. `id -u` and
# `id -g` print the appropriate values.
CUBED_CORE_UID=1000
CUBED_CORE_GID=1000

# One maximum size for every imported video, independent of frame rate. Large
# multipart uploads spill to temporary disk before streaming into the
# workspace, so keep about twice this value free while importing.
CUBED_CORE_MAX_UPLOAD_BYTES=1073741824

# Optional strict manifest for the rights-cleared camera models used by Label.
# Paths inside it are relative to the manifest. `cubed-core
# verify-tracker-models` verifies roles, sizes, hashes, licensing metadata, and
# path confinement. A host path is not translated inside a container; the
# Label/Decode Compose profiles mount CUBED_CORE_TRACKER_MODELS_DIR read-only at
# /models.
CUBED_CORE_TRACKER_MODEL_MANIFEST=

# Optional comma-separated exact ONNX Runtime provider names. Blank permits
# automatic CUDA/CoreML/CPU selection. Use one explicit provider for a
# reproducibility claim so camera-model inference fails instead of falling back:
#   CPUExecutionProvider
#   CUDAExecutionProvider
#   CoreMLExecutionProvider
CUBED_CORE_TRACKER_ONNX_PROVIDERS=

# Decode execution is opt-in, and blank means disabled. `native` runs the
# local_camera_v1 pipeline in this checkout with the
# current Python. `external` routes each job to an independently supplied
# runner, for example scripts/remote_decode_runner.sh for a remote GPU host.
# A decode job produces reconstruction evidence for one recording plus the
# server's own replay of the emitted moves. It reports no accuracy figure.
CUBED_CORE_DECODE_MODE=disabled

# Used only with CUBED_CORE_DECODE_MODE=external. Parsed once as argv and never
# run through a shell. Cubed Core appends:
#   --request <workspace/decode-jobs/.../job-request.json>
#   --output <workspace/decode-jobs/.../decode-result.json>
CUBED_CORE_DECODE_COMMAND=

# Operator-facing name for the configured decode runner, for example
# "Cloud GPU: RTX 4090 over SSH". Shown by the API so remote execution is
# visible. Purely descriptive.
CUBED_CORE_DECODE_RUNNER_LABEL=

# Host directory used by the Label/Decode Compose profiles. Put manifest.json
# and its relative model files here. Contents are ignored by Git and mounted
# read-only at /models; model bytes are never baked into the image.
CUBED_CORE_TRACKER_MODELS_DIR=./models/local

# Label uses the verified alignment-classifier and face-pose roles when a
# camera-tracker-v1 manifest is configured. That primary path needs no
# Label-specific model or command: the manifest powers
# model-aligned navigation, Predict, and Predict all.
#
# Advanced compatibility fallback only: when native models are not ready, both
# settings below enable an independently supplied Label predictor. The command
# is parsed once as argv and never passed through a shell. Cubed Core appends:
#   --request <temporary/request.json>
#   --output <temporary/output.json>
#   --model <CUBED_CORE_LABEL_MODEL_PATH>
# This fallback cannot provide model-aligned navigation. See
# docs/tutorials/LABEL.md for the bounded request/output contract.
CUBED_CORE_LABEL_PREDICT_COMMAND=
CUBED_CORE_LABEL_MODEL_PATH=

# Reproducible container inputs. These are multi-architecture manifest digests,
# not provider credentials. Update the tag and digest together after review.
CUBED_CORE_IMAGE=cubed-core:local
CUBED_CORE_LABEL_CPU_IMAGE=cubed-core:label-cpu
CUBED_CORE_DECODE_GPU_IMAGE=cubed-core:decode-gpu
CUBED_CORE_UV_IMAGE=ghcr.io/astral-sh/uv:0.11.16@sha256:440fd6477af86a2f1b38080c539f1672cd22acb1b1a47e321dba5158ab08864d
CUBED_CORE_NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
CUBED_CORE_PYTHON_IMAGE=python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
CUBED_CORE_GPU_SMOKE_IMAGE=ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
