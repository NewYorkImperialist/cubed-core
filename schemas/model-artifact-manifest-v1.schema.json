{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/model-artifact-manifest-v1.schema.json",
  "title": "Cubed Core model artifact manifest",
  "description": "Runtime identity, integrity, provenance, and redistribution metadata for user-supplied or rights-cleared model artifacts. Paths are relative to the manifest and are verified before inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "profile",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "cubed-core/model-artifact-manifest-v1"
    },
    "schema_version": {
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/identifier"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,99}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "format",
        "path",
        "bytes",
        "sha256",
        "redistribution",
        "license",
        "source",
        "model_card"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "format": {
          "enum": [
            "onnx",
            "numpy-npz",
            "generated-cache"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "redistribution": {
          "enum": [
            "approved",
            "external-only",
            "train-your-own",
            "withheld"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "model_card": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
