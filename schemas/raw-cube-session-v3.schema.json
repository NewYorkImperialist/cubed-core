{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/raw-cube-session-v3.schema.json",
  "title": "Cubed Core raw cube session export, relative-timestamp republish",
  "description": "Same shape as raw-cube-session-v2, for the cube_session.json artifacts republished with scripts/ble_relativize.py: moves[].t_ms and orientations[].t_ms are session-relative deltas, video_recording_id/video_link_status/video_ingest_fail_reason and clock.monotonic_start_ms are always absent (opaque private-ingest handles or absolute host-clock references), and a scrub block declares what was removed and why. See docs/research/MEMO_BLE_RELATIVE_REPUBLISH.md.",
  "type": "object",
  "required": [
    "device",
    "moves",
    "orientations",
    "zero_quat",
    "scrub"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1
    },
    "recording_id": {
      "type": "string",
      "minLength": 1
    },
    "video_recording_id": {
      "type": "string",
      "minLength": 1
    },
    "video_link_status": {
      "type": "string",
      "minLength": 1
    },
    "video_ingest_fail_reason": {
      "type": "string"
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "clock": {
      "type": "object",
      "required": [
        "relative_timebase",
        "move_event_time",
        "orientation_event_time"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "monotonic_start_ms": {
          "type": "number"
        },
        "relative_timebase": {
          "const": "host_performance_now"
        },
        "move_event_time": {
          "const": "event_local_timestamp_or_host_monotonic_fallback"
        },
        "orientation_event_time": {
          "const": "host_monotonic_receive"
        }
      },
      "additionalProperties": false
    },
    "scramble": {
      "type": "string"
    },
    "scramble_recorded": {
      "type": "string"
    },
    "start_state": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "type": "integer"
      }
    },
    "start_state_source": {
      "type": "string"
    },
    "solve_ms": {
      "type": "integer",
      "minimum": 0
    },
    "started_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "zero_quat": {
      "oneOf": [
        {
          "$ref": "#/$defs/quaternion"
        },
        {
          "type": "null"
        }
      ]
    },
    "moves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/move"
      }
    },
    "orientations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/orientation"
      }
    },
    "scrub": {
      "$ref": "#/$defs/scrub"
    }
  },
  "$defs": {
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "move": {
      "type": "object",
      "required": [
        "move",
        "facelets",
        "quat"
      ],
      "properties": {
        "t_ms": {
          "type": "integer"
        },
        "move": {
          "type": "string",
          "minLength": 1
        },
        "facelets": {
          "type": "string",
          "minLength": 54,
          "maxLength": 54
        },
        "quat": {
          "$ref": "#/$defs/quaternion"
        },
        "event_local_timestamp_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "cube_timestamp_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "serial": {
          "type": "integer",
          "minimum": 0
        },
        "clock_source": {
          "enum": [
            "event_local_timestamp",
            "host_monotonic_fallback"
          ]
        }
      },
      "additionalProperties": false
    },
    "orientation": {
      "type": "object",
      "required": [
        "quat"
      ],
      "properties": {
        "t_ms": {
          "type": "integer"
        },
        "quat": {
          "$ref": "#/$defs/quaternion"
        },
        "clock_source": {
          "const": "host_monotonic_receive"
        }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scrub": {
      "description": "Declaration of what was removed from the private record, the relative-timestamp rewrite applied, and what was kept on purpose. Matches the shape scripts/ble_relativize.py emits and the precedent gtD1's own clip_ble_ground_truth.json scrub block set.",
      "type": "object",
      "additionalProperties": false,
      "required": ["removed_fields", "relativized", "retained_note", "checks"],
      "properties": {
        "removed_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "relativized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "fields", "reference", "form", "note", "source_sha256"],
          "properties": {
            "done": {
              "const": true
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "form": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "retained_note": {
          "$ref": "#/$defs/note"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  },
  "additionalProperties": false
}
