{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/cubed-core-benchmark-v0-scramble.schema.json",
  "title": "Cubed Core Benchmark v0 scramble",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capture_id",
    "moves"
  ],
  "properties": {
    "schema": {
      "const": "cubed-core/benchmark-v0-scramble"
    },
    "schema_version": {
      "const": 1
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/move"
      }
    }
  },
  "$defs": {
    "move": {
      "type": "string",
      "pattern": "^[UDLRFB](?:'|2)?$"
    }
  }
}
