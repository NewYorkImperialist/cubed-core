{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/public-corpus-scramble-v1.schema.json",
  "title": "Cubed Core public corpus scramble",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "capture_id",
    "moves"
  ],
  "properties": {
    "schema": {
      "const": "cubed-core/public-corpus-scramble"
    },
    "schema_version": {
      "const": 1
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/move"
      }
    },
    "scramble": {
      "type": "object",
      "required": [
        "notation"
      ],
      "properties": {
        "notation": {
          "type": "string",
          "minLength": 1
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/move"
          }
        }
      },
      "additionalProperties": false
    },
    "initial_state": {
      "type": "object"
    },
    "derivation": {
      "type": "object",
      "required": [
        "method",
        "source_file"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "move_count": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        },
        "verification": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "move": {
      "type": "string",
      "pattern": "^[UDLRFB](?:'|2)?$"
    }
  },
  "additionalProperties": false
}
