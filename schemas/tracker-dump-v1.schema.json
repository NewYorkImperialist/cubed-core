{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/tracker-dump-v1.schema.json",
  "title": "Cubed Core internal camera-evidence projection",
  "description": "Internal viewer projection for per-frame camera evidence, pose faces, event spans, and move receipts. Decode exposes this information inside cubed-core/decode-result v1; this schema is not a separate compute job or public run artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "window",
    "gt",
    "emitted",
    "anchors",
    "events",
    "spans",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "cubed-core/tracker-dump-v1"
    },
    "schema_version": {
      "const": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "window": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      ],
      "items": false
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "gt": {
      "$ref": "#/$defs/moves"
    },
    "emitted": {
      "$ref": "#/$defs/moves"
    },
    "gt_canonical": {
      "$ref": "#/$defs/moves"
    },
    "emitted_canonical": {
      "$ref": "#/$defs/moves"
    },
    "anchors": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "type": "number"
          }
        ],
        "items": false
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
      }
    },
    "spans": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "frames": {
      "type": "object",
      "maxProperties": 250000,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/frame"
      }
    },
    "bridge": {
      "$ref": "#/$defs/moves"
    },
    "reach": {
      "type": "boolean"
    },
    "acc": {
      "type": "number"
    },
    "states": {
      "type": "array",
      "maxItems": 2001,
      "items": {
        "$ref": "#/$defs/cube_state"
      }
    }
  },
  "$defs": {
    "moves": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      ],
      "items": false
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corners",
        "kpt_conf",
        "conf"
      ],
      "properties": {
        "corners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "kpt_conf": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "conf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "face_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "lab",
        "confidence",
        "valid_pixels",
        "total_pixels",
        "used_fallback",
        "relative_area",
        "corners"
      ],
      "properties": {
        "slot": {
          "enum": [
            "up",
            "front",
            "right"
          ]
        },
        "lab": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              }
            ],
            "items": false
          }
        },
        "confidence": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "valid_pixels": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          }
        },
        "total_pixels": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        },
        "used_fallback": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "boolean"
          }
        },
        "relative_area": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "corners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "classified_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "colors",
        "conf",
        "dist"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "colors": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "conf": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "dist": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "cube_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "up",
        "right",
        "front",
        "down",
        "left",
        "back"
      ],
      "properties": {
        "up": {
          "$ref": "#/$defs/cube_face_colors"
        },
        "right": {
          "$ref": "#/$defs/cube_face_colors"
        },
        "front": {
          "$ref": "#/$defs/cube_face_colors"
        },
        "down": {
          "$ref": "#/$defs/cube_face_colors"
        },
        "left": {
          "$ref": "#/$defs/cube_face_colors"
        },
        "back": {
          "$ref": "#/$defs/cube_face_colors"
        }
      }
    },
    "cube_face_colors": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion"
      ],
      "properties": {
        "motion": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "aligned": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stk": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "nfaces": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "gated": {
          "type": "boolean"
        },
        "faces": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/face"
          }
        },
        "reads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/face_read"
          }
        },
        "read": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/classified_read"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "om",
        "score"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "om": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          ]
        },
        "score": {
          "type": "number"
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "f0",
        "f1",
        "event",
        "top"
      ],
      "properties": {
        "f0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "f1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "event": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    }
  }
}
