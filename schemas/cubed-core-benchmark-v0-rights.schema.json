{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubed-core.local/schemas/cubed-core-benchmark-v0-rights.schema.json",
  "title": "Cubed Core Benchmark v0 public rights record",
  "description": "Machine-readable publication gate. This record documents approval; it is not a substitute for retaining the underlying consent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_id",
    "capture_id",
    "source_status",
    "public_release",
    "terms_version",
    "terms_sha256",
    "acceptance_receipt_sha256",
    "approved_at",
    "reviewer_id",
    "authorization",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "cubed-core/benchmark-v0-rights"
    },
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{7,99}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "source_status": {
      "const": "approved-for-public-redistribution"
    },
    "public_release": {
      "const": true
    },
    "terms_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^(?!.*[Dd][Rr][Aa][Ff][Tt]).+$"
    },
    "terms_sha256": {
      "description": "SHA-256 of the exact final public-release terms accepted for this capture.",
      "$ref": "#/$defs/nonzero_sha256"
    },
    "acceptance_receipt_sha256": {
      "description": "SHA-256 of the retained terms-acceptance receipt; the receipt itself may remain outside the public bundle.",
      "$ref": "#/$defs/nonzero_sha256"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,99}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_holder_authorized",
        "recording_subjects_authorized",
        "public_redistribution_authorized",
        "ml_research_use_authorized",
        "adaptations_under_public_license_acknowledged",
        "withdrawal_policy_acknowledged",
        "privacy_review_approved",
        "audio_removed"
      ],
      "properties": {
        "rights_holder_authorized": {
          "const": true
        },
        "recording_subjects_authorized": {
          "const": true
        },
        "public_redistribution_authorized": {
          "const": true
        },
        "ml_research_use_authorized": {
          "const": true
        },
        "adaptations_under_public_license_acknowledged": {
          "description": "Acknowledges adaptations governed by the selected public data license. This is independent of whether a contributor publishes or licenses models or other independently produced outputs.",
          "const": true
        },
        "withdrawal_policy_acknowledged": {
          "const": true
        },
        "privacy_review_approved": {
          "const": true
        },
        "audio_removed": {
          "const": true
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/artifact_rights"
      }
    }
  },
  "$defs": {
    "nonzero_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "artifact_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "public_release",
        "public_license",
        "attribution",
        "rights_basis"
      ],
      "properties": {
        "role": {
          "enum": [
            "video",
            "high_speed_original",
            "video_derivation",
            "scramble",
            "calibration",
            "camera_metadata",
            "teacher_truth",
            "tracker_labels"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "public_release": {
          "const": true
        },
        "public_license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,79}$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rights_basis": {
          "enum": [
            "maintainer-owned",
            "authorized-contribution",
            "compatible-third-party-license"
          ]
        }
      }
    }
  }
}
